# latticed — lattice node daemon.
# Install: cargo build --release && install -Dm755 target/release/latticed /usr/local/bin/latticed
# install -Dm644 deploy/latticed.service /etc/systemd/system/latticed.service
# install -Dm644 deploy/lattice.sysusers /etc/sysusers.d/lattice.conf
# install -Dm644 deploy/lattice.tmpfiles.conf /etc/tmpfiles.d/lattice.conf
# systemd-sysusers && systemd-tmpfiles --create
# install -Dm600 deploy/lattice.example.toml /etc/lattice/lattice.toml
# systemctl daemon-reload && systemctl enable --now latticed
[Unit]
Description=Lattice node daemon
Documentation=https://github.com/taylorsatula/lattice
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root with egid=lattice (see deploy/lattice.sysusers). Files the
# daemon creates — including the application socket — are group lattice;
# the app socket is 0660 so group members can connect, the admin socket is
# 0600 root-only. The sandbox below (ProtectSystem, ProtectHome, no new
# privileges, restricted address families) limits what root can do.
Group=lattice
StateDirectory=lattice
StateDirectoryMode=0750
StateDirectoryGroup=lattice
ConfigurationDirectory=lattice
ConfigurationDirectoryMode=0750
ConfigurationDirectoryGroup=lattice
RuntimeDirectory=lattice
RuntimeDirectoryMode=0770
RuntimeDirectoryGroup=lattice

# Option A (default): encrypted/seeded identity in /var/lib/lattice (0700).
# Option B: systemd credentials instead of files — uncomment and remove the files:
# LoadCredential=signing_seed:/etc/lattice/keys/signing_seed
# LoadCredential=channel_seed:/etc/lattice/keys/channel_seed
# LoadCredential=envelope_seed:/etc/lattice/keys/envelope_seed
#
# The next signing key never lives on this host: `latticed init` writes it to
# an operator-chosen path outside the identity directory (or prints it once),
# and rotation takes it over the admin socket. The identity directory stores
# only its BLAKE3 commitment (next_key_commitment).

ExecStart=/usr/local/bin/latticed run --config /etc/lattice/lattice.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictRealtime=true
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
