# latticed — lattice node daemon.
# Install: cargo build --release && install -Dm755 target/release/latticed /usr/local/bin/latticed
# install -Dm644 deploy/latticed.service /etc/systemd/system/latticed.service
# install -Dm644 deploy/lattice.sysusers /etc/sysusers.d/lattice.conf
# install -Dm644 deploy/lattice.tmpfiles.conf /etc/tmpfiles.d/lattice.conf
# install -d -m 0750 -o root -g lattice /etc/lattice
# install -Dm640 -o root -g lattice deploy/lattice.example.toml /etc/lattice/lattice.toml
# systemd-sysusers && systemd-tmpfiles --create
# systemctl daemon-reload && systemctl enable --now latticed
[Unit]
Description=Lattice node daemon
Documentation=https://github.com/taylorsatula/lattice
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the dedicated unprivileged `lattice` user (see deploy/lattice.sysusers).
# Files the daemon creates — including the application socket — are group lattice;
# the app socket is 0660 so group members can connect, the admin socket is 0600
# owner-only. The config is 0640 root:lattice: readable by the daemon, writable
# only by root. The sandbox below (no capabilities, syscall filter, no new
# privileges, restricted address families, write access limited to the state
# and runtime directories) limits what the lattice user can do.
User=lattice
Group=lattice
StateDirectory=lattice
StateDirectoryMode=0750
StateDirectoryGroup=lattice
RuntimeDirectory=lattice
RuntimeDirectoryMode=0770
RuntimeDirectoryGroup=lattice

# Option A (default): encrypted/seeded identity in /var/lib/lattice (0750).
# Option B: systemd credentials instead of files — uncomment and remove the files:
# LoadCredential=signing_seed:/etc/lattice/keys/signing_seed
# LoadCredential=channel_seed:/etc/lattice/keys/channel_seed
# LoadCredential=envelope_seed:/etc/lattice/keys/envelope_seed
#
# The next signing key never lives on this host: `latticed init` writes it to
# an operator-chosen path outside the identity directory (or prints it once).
# The identity directory stores only its BLAKE3 commitment (next_key_commitment).
#
# Online rotation (latticectl rotate / rotate-envelope) is NOT supported in
# this mode: the daemon cannot update the credential that holds a seed, so
# both rotations are refused before any write. Rotate offline instead:
#   1. stop latticed
#   2. latticed rotate-offline --dir /var/lib/lattice --next-key-file <next-key> \
#        --next-next-commitment <hex>   (or --abandon)
#      latticed rotate-envelope-offline --dir /var/lib/lattice --seed-out <path>
#   3. provision the credential(s) with the new seed(s): the same next key for
#      signing_seed; the --seed-out file for envelope_seed
#   4. start latticed
# The following key for --next-next-commitment is generated offline, e.g.
# `latticed init --dir /tmp/scratch --next-key-out <following-key>` prints its
# commitment; discard the scratch identity afterwards.

ExecStart=/usr/local/bin/latticed run --config /etc/lattice/lattice.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lattice /run/lattice
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictRealtime=true
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
